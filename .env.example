# ============================================================
# HELP DESK — HEALTH & SAFETY
# Arquivo de Variaveis de Ambiente (.env.example)
# Copie para .env e preencha os valores reais
# ============================================================

# ── Ambiente ──────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://helpdesk_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/helpdesk_db
POSTGRES_USER=helpdesk_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=helpdesk_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT (Autenticacao) ────────────────────────────────────────
# Gerar chaves RS256: openssl genrsa -out private.pem 2048
#                     openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
JWT_ALGORITHM=RS256
JWT_ISSUER=helpdesk.healthsafetytech.com

# ── Segundo fator (TOTP) ──────────────────────────────────────
# Chave que cifra o segredo TOTP no banco. O segredo NAO pode ser hasheado --
# o servidor recalcula o codigo a partir dele a cada login -- entao o que
# protege e esta chave morar FORA do banco.
#
# Gerar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Deixar vazia e uma escolha valida: o segundo fator fica indisponivel e o
# login segue como sempre. NAO existe chave default, e nao ha nenhuma no
# repositorio -- uma chave versionada cifraria sem proteger de ninguem.
# Trocar esta chave torna ilegiveis os segredos ja cadastrados: quem tinha MFA
# precisa cadastrar de novo.
MFA_SECRET_ENCRYPTION_KEY=

# ── Confirmacao de e-mail e recuperacao de senha ─────────────
# Endereco publico do sistema — usado para montar os links dos e-mails
FRONTEND_URL=http://localhost:5173
# Validade dos links
EMAIL_VERIFICATION_TOKEN_HOURS=24
PASSWORD_RESET_TOKEN_HOURS=1
# A exigencia de confirmar o e-mail no cadastro e ADOTADA por esta flag —
# preencher as variaveis de SMTP sozinho NAO a liga (ja travou login em
# producao: SMTP preenchido sem funcionar = conta presa esperando e-mail).
# So mude para true com o SMTP configurado E testado; em producao, a flag
# ligada sem SMTP recusa o boot.
EMAIL_VERIFICATION_ENABLED=false

# ── Armazenamento de arquivos (anexos e fotos de perfil) ─────
# Este caminho PRECISA ser um volume no deploy. Sem volume, o Docker descarta
# os arquivos a cada redeploy do container.
UPLOAD_DIR=/app/uploads
# Validade (em segundos) do link temporario de download
FILE_URL_EXPIRES_SECONDS=3600

# ── MinIO ─────────────────────────────────────────────────────
# Nao e mais usado: o armazenamento passou a ser em disco (UPLOAD_DIR).
# As variaveis seguem aqui apenas para nao quebrar ambientes antigos.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET_NAME=helpdesk-attachments
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9001

# ── LLM / IA ─────────────────────────────────────────────────
# Interruptor da IA. false para de mandar conteudo de chamado para
# OpenAI/Anthropic sem precisar apagar as chaves.
LLM_ENABLED=true

# Interruptor so da Helo -- o atendimento por IA que FALA COM O CLIENTE.
# Separado do LLM_ENABLED: desligar a Helo nao pode apagar junto a
# classificacao automatica e o "melhorar redacao", que sao do tecnico.
# Nasce DESLIGADA: ligar a IA para conversar com cliente e decisao, nao
# default que chega no deploy seguinte sem ninguem pedir.
HELO_ENABLED=false

# ── LLM / IA — Provider Primario (OpenAI) ────────────────────
OPENAI_API_KEY=sk-CHANGE_ME_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3

# ── LLM / IA — Provider Fallback (Anthropic) ─────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── LLM — Configuracoes Gerais ───────────────────────────────
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_FALLBACK_ENABLED=true

# ── SMTP (Email — FastAPI-Mail) ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=helpdesk@healthsafetytech.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM_NAME=Help Desk Health & Safety
SMTP_FROM_EMAIL=helpdesk@healthsafetytech.com
# Para onde vao as respostas de quem responder um e-mail automatico.
# Vazio = caem na propria caixa de disparo, que normalmente ninguem le.
SMTP_REPLY_TO=

# ── ClamAV (Antivirus) ───────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# ── WebSocket (FastAPI) ──────────────────────────────────────
WS_HEARTBEAT_INTERVAL=25
WS_MAX_CONNECTIONS=1000

# ── Upload de Arquivos ───────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.txt,.csv,.zip,.rar
UPLOAD_MAX_FILES_PER_TICKET=10

# ── Logs e Observabilidade (Loguru) ──────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=./logs
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# ── Rate Limiting (slowapi) ─────────────────────────────────
RATE_LIMIT_LOGIN=5/15minutes

# IPs/redes cujo X-Forwarded-For o uvicorn aceita como o IP real de quem
# chamou. Vazio = confia em ninguem (default do uvicorn: 127.0.0.1).
#
# ATENCAO, decisao de topologia — os dois lados doem:
#   - Vazio atras de um proxy: o rate limit de login enxerga sempre o IP do
#     proxy, virando UM balde para todo mundo (5 senhas erradas de qualquer
#     pessoa travam o login de todos).
#   - "*" com a porta do backend publicada na internet: qualquer um forja o
#     X-Forwarded-For e pula o rate limit por completo.
# So preencha depois de confirmar que o container do backend e alcancavel
# apenas pela rede interna do proxy.
#
# EM 19/08/2026 A PORTA 8000 ESTA PUBLICADA: deixar vazio. Fechar a
# publicacao no EasyPanel primeiro, so entao preencher. Ver mudancas.md.
# FORWARDED_ALLOW_IPS=

# ── Seguranca ────────────────────────────────────────────────
BCRYPT_ROUNDS=12
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS

# Senha do admin criado pelo seed no boot. SO em desenvolvimento: em
# producao a variavel NAO deve existir — a ausencia impede o seed de criar
# admin com senha conhecida. Em dev usa-se Admin@123456 (default do e2e).
SEED_ADMIN_PASSWORD=

# ── Frontend (Vite) ──────────────────────────────────────────
# Opcional em dev: sem ela o front usa /api/v1 e o proxy do Vite encaminha
# para o backend local na 8001. Obrigatoria como build arg no Docker/EasyPanel.
# VITE_WS_URL / VITE_APP_NAME / VITE_APP_VERSION foram removidas: nada as le.
VITE_API_URL=http://localhost:8001/api/v1

# ── Docker — Producao (override no .env.production) ──────────
# DOMAIN=helpdesk.healthsafetytech.com
# SSL_EMAIL=ti@healthsafetytech.com
# NGINX_CLIENT_MAX_BODY_SIZE=25M
# UVICORN_WORKERS=4
# GUNICORN_WORKERS=4
